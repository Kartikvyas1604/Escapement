# Escapement web app environment (copy to .env.local for local dev)

# Cluster: devnet | testnet | mainnet-beta | localnet
NEXT_PUBLIC_CLUSTER=devnet

# RPC endpoint (defaults to the public cluster endpoint if unset)
# NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Deployed program ids (devnet)
NEXT_PUBLIC_ESCAPEMENT_PROGRAM_ID=KKAQbHv1YAHo3wAAVETEQGaPBix5tRHWdXcb4G28V6z
NEXT_PUBLIC_TEMPLATE_PROGRAM_ID=E52t2PvfqcE71MGafrLPJBgXN74WdRmkzUk9aBLLLHfi

# Fee schedule in lamports (defaults; must match the on-chain market config)
# NEXT_PUBLIC_BASE_LAMPORTS=5000
# NEXT_PUBLIC_PER_TICK_LAMPORTS=10000

# Server-side protocol crank (Next route handler /api/crank). Provide the
# market authority keypair as a JSON array, or a path to a keypair file.
# CRANK_KEYPAIR=[12,34,...]
# CRANK_KEYPAIR_PATH=/Users/you/.config/solana/id.json
