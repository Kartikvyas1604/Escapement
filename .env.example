# Escapement web app environment (copy to .env.local for local dev)

# Cluster: devnet | testnet | mainnet-beta | localnet
NEXT_PUBLIC_CLUSTER=devnet

# Public site URL (canonical links, sitemap, robots, OG metadata)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# RPC endpoint (defaults to the public cluster endpoint if unset)
# NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Deployed program ids (devnet)
NEXT_PUBLIC_ESCAPEMENT_PROGRAM_ID=KKAQbHv1YAHo3wAAVETEQGaPBix5tRHWdXcb4G28V6z
NEXT_PUBLIC_TEMPLATE_PROGRAM_ID=E52t2PvfqcE71MGafrLPJBgXN74WdRmkzUk9aBLLLHfi

# Lease economics and bounds (must match the on-chain market config and the
# program constants MIN/MAX_INTERVAL_MS and MIN/MAX_ITERATIONS)
# NEXT_PUBLIC_BASE_LAMPORTS=5000
# NEXT_PUBLIC_PER_TICK_LAMPORTS=10000
# NEXT_PUBLIC_INTERVAL_MIN_MS=100
# NEXT_PUBLIC_INTERVAL_MAX_MS=2000
# NEXT_PUBLIC_ITERATIONS_MIN=1
# NEXT_PUBLIC_ITERATIONS_MAX=100

# Cadence preset buttons in the mint form (comma-separated ms values)
# NEXT_PUBLIC_PRESETS_MS=250,500,1000

# Server-side protocol crank (Next route handler /api/crank). Provide the
# market authority keypair as a JSON array, or a path to a keypair file.
# CRANK_KEYPAIR=[12,34,...]
# CRANK_KEYPAIR_PATH=/Users/you/.config/solana/id.json

# ---------------------------------------------------------------------------
# Scripts (node scripts/*.mjs, shell scripts/*.sh)
# ---------------------------------------------------------------------------
# CLUSTER_URL=https://api.devnet.solana.com
# WALLET_PATH=~/.config/solana/id.json
# ESCAPEMENT_PROGRAM_ID=KKAQbHv1YAHo3wAAVETEQGaPBix5tRHWdXcb4G28V6z
# TEMPLATE_PROGRAM_ID=E52t2PvfqcE71MGafrLPJBgXN74WdRmkzUk9aBLLLHfi
# FEE_BASE=5000
# FEE_PER_TICK=10000
# E2E_INTERVAL_MS=100
# E2E_ITERATIONS=2

# ---------------------------------------------------------------------------
# x402 agent payments (POST /api/leases, spec v2 — see apps/web/lib/x402.ts)
# ---------------------------------------------------------------------------
# Wallet that receives USDC payments (required to enable the endpoint).
# X402_PAY_TO=YourDevnetAddressGoesHere
# Facilitator used for /verify and /settle (default: Coinbase public one).
# X402_FACILITATOR_URL=https://x402.org/facilitator
# Lease price in USDC atomic units (6 decimals). Default 10000 = $0.01.
# X402_LEASE_PRICE_ATOMIC=10000
# Payment asset mint (Circle devnet USDC by default).
# X402_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
